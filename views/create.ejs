<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans p-8">
    <div class="max-w-xl mx-auto bg-white p-6 rounded-lg shadow-md">
        <h1 class="text-2xl font-bold mb-6 text-gray-800">Tambah Produk Baru</h1>
        <form action="/tambah-produk" method="POST" class="space-y-4">
            <div>
                <label class="block text-gray-700 font-semibold mb-1">Nama Produk</label>
                <input type="text" name="name" required class="w-full border rounded p-2 border-gray-300">
            </div>
            <div>
                <label class="block text-gray-700 font-semibold mb-1">Harga (Rp)</label>
                <input type="number" name="price" required class="w-full border rounded p-2 border-gray-300">
            </div>
            <div>
                <label class="block text-gray-700 font-semibold mb-1">Kategori</label>
                <select name="category" required class="w-full border rounded p-2 border-gray-300">
                    <option value="Sparepart">Sparepart</option>
                    <option value="Aksesoris">Aksesoris</option>
                    <option value="E-Bike">E-Bike</option>
                </select>
            </div>
            <div>
                <label class="block text-gray-700 font-semibold mb-1">Deskripsi</label>
                <textarea name="description" rows="3" class="w-full border rounded p-2 border-gray-300"></textarea>
            </div>
            <div class="flex justify-between items-center pt-4">
                <a href="/" class="text-gray-600 hover:underline">Batal</a>
                <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded font-semibold hover:bg-blue-700">Simpan Produk</button>
            </div>
        </form>
    </div>
</body>
</html>