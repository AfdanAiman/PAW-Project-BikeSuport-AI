<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
</head>
<body>

  <%- include('partials/navbar', { active: '' }) %>

  <main class="container my-5" style="max-width:720px">
    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb mb-0 small">
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Beranda</a></li>
        <li class="breadcrumb-item active" aria-current="page">Tambah Produk</li>
      </ol>
    </nav>

    <div class="surface p-4 p-md-5">
      <div class="d-flex align-items-center gap-3 mb-4">
        <div class="metric-icon d-flex align-items-center justify-content-center fs-4" style="width:50px;height:50px;border-radius:14px;background:var(--brand-soft);color:var(--brand)"><i class="bi bi-plus-lg"></i></div>
        <div>
          <h1 class="h3 fw-bold mb-0">Tambah Produk Baru</h1>
          <p class="text-muted small mb-0">Lengkapi data produk untuk ditampilkan di katalog.</p>
        </div>
      </div>

      <form action="/tambah-produk" method="POST" class="d-grid gap-4">
        <div>
          <label for="name" class="form-label">Nama Produk</label>
          <input type="text" id="name" name="name" class="form-control" placeholder="Contoh: Ban Luar Sepeda 26 x 1.75" required>
        </div>

        <div class="row g-3">
          <div class="col-md-6">
            <label for="price" class="form-label">Harga</label>
            <div class="input-group">
              <span class="input-group-text">Rp</span>
              <input type="number" id="price" name="price" class="form-control" placeholder="75000" min="0" required>
            </div>
          </div>
          <div class="col-md-6">
            <label for="category" class="form-label">Kategori</label>
            <select id="category" name="category" class="form-select" required>
              <option value="Sparepart">Sparepart</option>
              <option value="Aksesoris">Aksesoris</option>
              <option value="E-Bike">E-Bike</option>
            </select>
          </div>
        </div>

        <div>
          <label for="description" class="form-label">Deskripsi</label>
          <textarea id="description" name="description" rows="4" class="form-control" placeholder="Jelaskan keunggulan dan spesifikasi produk..."></textarea>
        </div>

        <div class="d-flex flex-column-reverse flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-2 pt-3 border-top">
          <a href="/" class="btn btn-soft px-4">Batal</a>
          <button type="submit" class="btn btn-brand px-4 py-2"><i class="bi bi-check2-circle me-1"></i> Simpan Produk</button>
        </div>
      </form>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
