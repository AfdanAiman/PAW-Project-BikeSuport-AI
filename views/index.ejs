<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">🚲 BikeSupport Web Store</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link text-warning" href="/api/status" target="_blank">GET /api/status</a>
                <a class="nav-link text-warning" href="/api/produk" target="_blank">GET /api/produk</a>
            </div>
        </div>
    </nav>

    <!-- Header Banner Sesuai PRD (Low Cost, High Profit) -->
    <header class="bg-primary text-white text-center py-5 shadow-sm">
        <div class="container">
            <h1 class="fw-bold display-5">Pusat Sparepart Sepeda & E-Bike Terlengkap</h1>
            <p class="lead mb-3">Menjangkau pembeli luar kota secara langsung tanpa potongan biaya marketplace — <strong>Low Cost, High Profit</strong>.</p>
            <span class="badge bg-light text-dark fs-6 px-3 py-2">PAW Week 7 — MVC & REST API Integration</span>
        </div>
    </header>

    <!-- Main Content Katalog Produk -->
    <div class="container my-5">
        <div class="row mb-4">
            <div class="col">
                <h3 class="fw-bold text-dark border-bottom pb-2">Katalog Produk & Suku Cadang</h3>
            </div>
        </div>

        <div class="row">
            <% products.forEach(product => { %>
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body d-flex flex-column">
                            <div>
                                <span class="badge bg-secondary mb-2"><%= product.category %></span>
                                <h5 class="card-title fw-bold text-dark"><%= product.name %></h5>
                                <p class="card-text text-muted small"><%= product.description %></p>
                            </div>
                            <div class="mt-auto pt-3">
                                <p class="card-text text-success fs-5 fw-bold mb-3"><%= formatRupiah(product.price) %></p>
                                <a href="https://wa.me/6285158110356?text=Halo%20Admin%20BikeSupport,%20saya%20tertarik%20untuk%20membeli%20produk:%20*<%= encodeURIComponent(product.name) %>*" 
                                   target="_blank" 
                                   class="btn btn-outline-success btn-sm w-100 fw-semibold">
                                   Pesan via WhatsApp (Tanpa Admin Fee)
                               </a>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-dark text-white text-center py-3 mt-5">
        <div class="container">
            <p class="mb-0 small text-muted">&copy; 2026 BikeSupport Web Store. Dikembangkan untuk Tugas PPAW Week 7.</p>
        </div>
    </footer>

    <!-- Bootstrap JS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>