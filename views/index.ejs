<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
  <style>
    .hero{position:relative;color:#fff;text-align:center;padding:88px 0 120px;
      background:radial-gradient(circle at 50% -20%,#3730a3 0%,#09090b 72%)}
    .hero::before{content:'';position:absolute;inset:0;opacity:.35;pointer-events:none;
      background-image:radial-gradient(rgba(255,255,255,.18) 1px,transparent 1px);background-size:26px 26px;
      -webkit-mask-image:linear-gradient(to bottom,#000,transparent);mask-image:linear-gradient(to bottom,#000,transparent)}
    .hero .container{position:relative}
    .hero-badge{display:inline-flex;align-items:center;gap:8px;padding:7px 16px;border-radius:999px;font-size:.82rem;font-weight:600;
      background:rgba(99,102,241,.18);border:1px solid rgba(129,140,248,.4);color:#e0e7ff}
    .hero h1{color:#fff;font-weight:800;font-size:clamp(2rem,5vw,3.4rem);line-height:1.1}
    .hero h1 span{background:linear-gradient(90deg,#a5b4fc,#c4b5fd);-webkit-background-clip:text;background-clip:text;color:transparent}
    .hero p{color:#a1a1aa;max-width:620px;margin-inline:auto}

    .metrics{margin-top:-52px;position:relative;z-index:10}
    .metric{padding:20px;display:flex;align-items:center;gap:16px;transition:.2s;height:100%}
    .metric:hover{transform:translateY(-3px);box-shadow:var(--shadow-md)}
    .metric-icon{width:50px;height:50px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex:none}
    .metric-label{font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);font-weight:700}
    .metric-value{font-family:'Outfit',sans-serif;font-weight:700;font-size:1.4rem;color:var(--ink);line-height:1.2}

    .toolbar{padding:24px}
    .search-box{display:flex;align-items:center;gap:8px;background:#fff;border:1px solid #cbd5e1;border-radius:12px;padding:4px 6px 4px 14px;transition:.2s;min-width:0}
    .search-box:focus-within{border-color:var(--brand);box-shadow:0 0 0 4px rgba(79,70,229,.14)}
    .search-box input{border:0;outline:0;background:transparent;flex:1;min-width:0;padding:8px 0}

    .chip-filter{border:1px solid var(--line);background:#fff;color:var(--text);border-radius:999px;padding:7px 16px;font-size:.86rem;font-weight:600;transition:.15s}
    .chip-filter:hover{border-color:#a5b4fc;color:var(--brand)}
    .chip-filter.active{background:var(--ink);border-color:var(--ink);color:#fff}
    .chip-filter .n{opacity:.6;font-weight:500;margin-left:4px}

    /* ===== Kartu produk ===== */
    .product-card{height:100%;display:flex;flex-direction:column;position:relative;border-radius:18px;
      transition:transform .28s cubic-bezier(.16,1,.3,1),box-shadow .28s,border-color .28s}
    .product-card:hover{transform:translateY(-6px);border-color:#c7d2fe;box-shadow:0 24px 40px -18px rgba(15,23,42,.28)}

    .product-media{position:relative;aspect-ratio:4/3;border-radius:18px 18px 0 0;overflow:hidden;
      display:flex;align-items:center;justify-content:center;
      background:linear-gradient(160deg,var(--t1) 0%,#fff 90%)}
    .product-media::before{content:'';position:absolute;width:78%;aspect-ratio:1;border-radius:50%;
      background:radial-gradient(circle,var(--t2) 0%,rgba(255,255,255,0) 68%);opacity:.9;transition:transform .5s}
    .product-card:hover .product-media::before{transform:scale(1.15)}
    .product-media .tile{position:relative;width:84px;height:84px;border-radius:24px;background:#fff;color:var(--tf);
      display:flex;align-items:center;justify-content:center;font-size:2.5rem;
      box-shadow:0 14px 30px -12px rgba(15,23,42,.28),inset 0 0 0 1px rgba(15,23,42,.04);transition:transform .4s cubic-bezier(.16,1,.3,1)}
    .product-card:hover .tile{transform:translateY(-4px) rotate(-5deg) scale(1.05)}
    .product-media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}

    .cat-label{display:inline-flex;align-items:center;gap:6px;font-size:.7rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--tf)}
    .cat-label::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--tf)}
    .product-title{font-size:1.02rem;font-weight:600;line-height:1.35;margin:.45rem 0 .5rem;
      display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.7em}
    .product-title a{color:var(--ink);text-decoration:none}
    .product-card:hover .product-title a{color:var(--brand)}
    .product-desc{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.7em;color:var(--muted);font-size:.85rem;line-height:1.35;margin:0}

    .product-foot{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;border-top:1px solid var(--line);padding:16px 20px 18px;margin-top:auto}
    .price-label{font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
    .price{font-family:'Outfit',sans-serif;font-weight:700;font-size:1.28rem;color:var(--ink);line-height:1.15}
    .foot-actions{position:relative;z-index:3;display:flex;gap:6px}
    .btn-cart{background:#4f46e5;color:#fff;border:0;padding:0 14px;height:40px;display:inline-flex;align-items:center;gap:6px;font-size:0.85rem;font-weight:600;border-radius:12px}
    .btn-cart:hover{background:#4338ca;color:#fff}
    .btn-cart.closed{background:#e2e8f0;color:#64748b;cursor:not-allowed}
    .btn-more{background:#fff;border:1px solid var(--line);color:var(--muted);width:40px;height:40px;padding:0;display:inline-flex;align-items:center;justify-content:center;border-radius:12px}
    .btn-more:hover,.btn-more.show{background:#f1f5f9;color:var(--ink)}
    .dropdown-menu{border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow-md);padding:6px;font-size:.9rem}
    .dropdown-item{border-radius:8px;padding:8px 12px;display:flex;align-items:center;gap:8px}
    .dropdown-item.text-danger:hover{background:#fef2f2}

    /* Floating Cart Button (Digeser ke kiri agar tidak menutupi chatbot) */
    .floating-cart-btn {
      position: fixed; bottom: 30px; right: 110px; z-index: 1050;
      background: #16a34a; color: #fff; border-radius: 50px; padding: 12px 24px;
      box-shadow: 0 10px 25px rgba(22, 163, 74, 0.4); display: flex; align-items: center; gap: 10px;
      font-weight: 600; border: none; transition: transform 0.2s;
    }
    .floating-cart-btn:hover { transform: scale(1.05); background: #15803d; color: #fff; }
  </style>
</head>
<body>

  <%- include('partials/navbar', { active: 'katalog' }) %>

  <%
    const total = products.length;
    const categories = [...new Set(products.map(p => p.category))];
    const themes = {
      'Sparepart': { c: 'theme-sparepart', i: 'bi-gear-wide-connected' },
      'Aksesoris': { c: 'theme-aksesoris', i: 'bi-shield-check' },
      'E-Bike':    { c: 'theme-ebike',     i: 'bi-lightning-charge-fill' }
    };
    const hasSearch = (typeof searchQuery !== 'undefined' && searchQuery);
    const isOpen = (typeof store === 'undefined') || store.open;
  %>

  <!-- Hero -->
  <header class="hero">
    <div class="container">
      <span class="hero-badge mb-4"><i class="bi bi-rocket-takeoff"></i> Enterprise Inventory &amp; Storefront System</span>
      <h1 class="mb-3">Pusat Suku Cadang &amp; <span>E-Bike Profesional</span></h1>
      <p class="mb-4 fs-6">Solusi lengkap kebutuhan sepeda dan e-bike Anda dalam satu tempat. Temukan suku cadang asli dengan ketersediaan stok yang akurat.</p>
      <div class="d-flex flex-wrap justify-content-center gap-2">
        <a href="#katalog" class="btn btn-brand px-4 py-2"><i class="bi bi-grid me-1"></i> Jelajahi Produk</a>
      </div>
    </div>
  </header>

  <!-- Metrics / Ringkasan -->
  <section class="container metrics" aria-label="Ringkasan">
    <div class="row g-3 justify-content-center">
      <div class="col-6 col-lg-3">
        <div class="surface metric">
          <div class="metric-icon" style="background:#fffbeb;color:#d97706"><i class="bi bi-shield-check"></i></div>
          <div><div class="metric-label">Status Toko</div><div class="metric-value fs-5 <%= isOpen ? 'text-success' : 'text-danger' %>"><%= isOpen ? 'Buka' : 'Tutup' %></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Katalog -->
  <main class="container my-5 pt-2" id="katalog">
    <div class="surface toolbar mb-3">
      <div class="row align-items-center g-3">
        <div class="col-lg-5">
          <h2 class="h3 fw-bold mb-1">Daftar Produk</h2>
          <p class="text-muted small mb-0">Cek ketersediaan suku cadang dan masukkan ke keranjang belanja.</p>
        </div>
        <div class="col-lg-7">
          <form action="/" method="GET" class="d-flex gap-2 justify-content-lg-end" role="search">
            <div class="search-box flex-grow-1" style="max-width:420px">
              <i class="bi bi-search text-muted"></i>
              <input type="text" name="search" value="<%= hasSearch ? searchQuery : '' %>" placeholder="Cari nama produk..." aria-label="Cari nama produk">
              <% if (hasSearch) { %>
                <a href="/" class="btn btn-sm text-danger px-2" title="Reset pencarian"><i class="bi bi-x-lg"></i></a>
              <% } %>
            </div>
            <button type="submit" class="btn btn-dark px-4">Cari</button>
          </form>
        </div>
      </div>
    </div>

    <% if (hasSearch) { %>
      <p class="text-muted small mb-3"><i class="bi bi-funnel me-1"></i> Hasil pencarian untuk <strong class="text-dark">&ldquo;<%= searchQuery %>&rdquo;</strong></p>
    <% } %>

    <% if (total > 0) { %>
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div class="d-flex flex-wrap gap-2" role="group" aria-label="Filter kategori">
          <button type="button" class="chip-filter active" data-filter="all">Semua<span class="n"><%= total %></span></button>
          <% categories.forEach(cat => { %>
            <button type="button" class="chip-filter" data-filter="<%= cat %>"><%= cat %><span class="n"><%= products.filter(p => p.category === cat).length %></span></button>
          <% }) %>
        </div>
        <span class="text-muted small">Menampilkan <strong class="text-dark" id="resultCount"><%= total %></strong> produk</span>
      </div>
    <% } %>

    <div class="row g-4">
      <% if (total === 0) { %>
        <div class="col-12">
          <div class="surface text-center py-5 px-3">
            <div class="display-4 text-muted mb-2"><i class="bi bi-search"></i></div>
            <h3 class="h5 fw-bold">Produk Tidak Ditemukan</h3>
            <p class="text-muted small mb-3">Tidak ada hasil yang cocok dengan kata kunci pencarian Anda.</p>
            <a href="/" class="btn btn-soft btn-sm px-3">Reset Pencarian</a>
          </div>
        </div>
      <% } else { %>
        <% products.forEach(product => {
             const th = themes[product.category] || themes['Sparepart'];
             const img = product.image || product.imageUrl || product.gambar || '';
        %>
          <div class="col-sm-6 col-lg-4 col-xl-3 product-col" data-category="<%= product.category %>">
            <article class="surface product-card <%= th.c %>">
              <div class="product-media">
                <% if (img) { %>
                  <img src="<%= img %>" alt="<%= product.name %>" loading="lazy">
                <% } else { %>
                  <div class="tile"><i class="bi <%= th.i %>"></i></div>
                <% } %>
              </div>

              <div class="px-4 pt-3 pb-3">
                <span class="cat-label"><%= product.category %></span>
                <h3 class="product-title"><a href="/produk/<%= product.id %>" class="stretched-link"><%= product.name %></a></h3>
                <p class="product-desc"><%= product.description || 'Komponen suku cadang berkualitas tinggi bergaransi resmi.' %></p>
              </div>

              <div class="product-foot">
                <div>
                  <div class="price-label">Harga</div>
                  <div class="price"><%= formatRupiah(product.price) %></div>
                </div>
                <div class="foot-actions">
                  <% if (isOpen) { %>
                    <!-- TOMBOL KERANJANG HANYA MUNCUL JIKA BUKAN ADMIN (!locals.isAdmin) -->
                    <% if (!locals.isAdmin) { %>
                    <button type="button" class="btn btn-cart" 
                            onclick="addToCart('<%= product.id %>', '<%= product.name.replace(/'/g, "\\'") %>', <%= product.price %>)"
                            title="Tambah ke Keranjang">
                      <i class="bi bi-cart-plus"></i> Keranjang
                    </button>
                    <% } %>
                  <% } else { %>
                    <% if (!locals.isAdmin) { %>
                    <button type="button" class="btn btn-cart closed" disabled title="Toko sedang tutup"><i class="bi bi-moon-stars"></i> Tutup</button>
                    <% } %>
                  <% } %>

                  <!-- TOMBOL EDIT & HAPUS ADMIN -->
                  <% if (locals.isAdmin) { %>
                  <div class="dropdown">
                    <button class="btn btn-more" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menu produk"><i class="bi bi-three-dots-vertical"></i></button>
                    <ul class="dropdown-menu dropdown-menu-end">
                      <li><a class="dropdown-item" href="/produk/<%= product.id %>"><i class="bi bi-eye"></i> Lihat detail</a></li>
                      <li><a class="dropdown-item" href="/edit-produk/<%= product.id %>"><i class="bi bi-pencil-square"></i> Edit</a></li>
                      <li><hr class="dropdown-divider"></li>
                      <li>
                        <form action="/hapus-produk/<%= product.id %>" method="POST" onsubmit="return confirm('Yakin ingin menghapus produk ini?')">
                          <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash"></i> Hapus</button>
                        </form>
                      </li>
                    </ul>
                  </div>
                  <% } %>
                </div>
              </div>
            </article>
          </div>
        <% }) %>

        <div class="col-12 d-none" id="filterEmpty">
          <div class="surface text-center py-5 text-muted">Tidak ada produk pada kategori ini.</div>
        </div>
      <% } %>
    </div>
  </main>

  <!-- Tombol Mengambang Keranjang Belanja HANYA MUNCUL JIKA BUKAN ADMIN -->
  <% if (!locals.isAdmin) { %>
  <button type="button" class="floating-cart-btn" data-bs-toggle="modal" data-bs-target="#cartModal">
    <i class="bi bi-cart3 fs-5"></i> Keranjang <span id="cartBadge" class="badge bg-light text-success rounded-pill">0</span>
  </button>
  <% } %>

  <!-- Modal Keranjang Belanja & Checkout Form -->
  <div class="modal fade" id="cartModal" tabindex="-1" aria-labelledby="cartModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content rounded-4 border-0 shadow">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold" id="cartModalLabel"><i class="bi bi-cart-check me-2"></i> Keranjang Belanja Anda</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body py-3">
          <!-- Daftar Item di Keranjang -->
          <div id="cartItemsContainer" class="table-responsive mb-3" style="max-height: 250px; overflow-y: auto;">
            <table class="table align-middle">
              <thead>
                <tr>
                  <th>Produk</th>
                  <th>Harga</th>
                  <th style="width: 100px;">Qty</th>
                  <th>Subtotal</th>
                  <th>Aksi</th>
                </tr>
              </thead>
              <tbody id="cartTableBody">
                <!-- Javascript will inject cart items here -->
              </tbody>
            </table>
          </div>
          <div id="emptyCartNotice" class="text-center py-4 text-muted">
            <i class="bi bi-cart-x fs-1 d-block mb-2"></i>
            Keranjang belanja masih kosong. Silakan pilih produk dari katalog.
          </div>

          <hr class="my-3">

          <!-- Form Pemesanan / Checkout -->
          <form id="checkoutForm">
            <h6 class="fw-bold mb-3 text-dark"><i class="bi bi-file-earmark-text me-1"></i> Formulir Pengiriman Pesanan</h6>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label small fw-semibold">Nama Lengkap</label>
                <input type="text" name="buyerName" class="form-control rounded-3" placeholder="Contoh: Budi Santoso" required>
              </div>
              <div class="col-md-6">
                <label class="form-label small fw-semibold">Nomor WhatsApp / HP</label>
                <input type="text" name="buyerPhone" class="form-control rounded-3" placeholder="Contoh: 081234567890" required>
              </div>
              <div class="col-12">
                <label class="form-label small fw-semibold">Alamat Pengiriman Lengkap</label>
                <textarea name="address" class="form-control rounded-3" rows="2" placeholder="Contoh: Jl. Ringroad Selatan, Yogyakarta" required></textarea>
              </div>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-3 p-3 bg-light rounded-3">
              <span class="fw-bold text-secondary">Total Pembayaran:</span>
              <span id="cartTotalPrice" class="fs-5 fw-bold text-success">Rp 0</span>
            </div>
          </form>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-light btn-rounded px-3" data-bs-dismiss="modal">Tutup</button>
          <button type="button" id="checkoutBtn" class="btn btn-success px-4 fw-semibold rounded-3" onclick="submitCheckout()" disabled>
            <i class="bi bi-whatsapp me-1"></i> Kirim Pesanan &amp; WhatsApp
          </button>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script>
    let cart = JSON.parse(localStorage.getItem('bikesupport_cart')) || [];

    function saveCart() {
      localStorage.setItem('bikesupport_cart', JSON.stringify(cart));
      updateCartUI();
    }

    function addToCart(id, name, price) {
      const existingItem = cart.find(item => item.id === id);
      if (existingItem) {
        existingItem.quantity += 1;
      } else {
        cart.push({ id, name, price: Number(price), quantity: 1 });
      }
      saveCart();
      alert(`Produk "${name}" berhasil ditambahkan ke keranjang!`);
    }

    function updateQuantity(id, change) {
      const item = cart.find(item => item.id === id);
      if (item) {
        item.quantity += change;
        if (item.quantity <= 0) {
          cart = cart.filter(i => i.id !== id);
        }
      }
      saveCart();
    }

    function removeFromCart(id) {
      cart = cart.filter(i => i.id !== id);
      saveCart();
    }

    function updateCartUI() {
      const cartTableBody = document.getElementById('cartTableBody');
      const cartBadge = document.getElementById('cartBadge');
      if (!cartBadge) return; // Jika admin, elemen badge tidak ada di DOM

      cartTableBody.innerHTML = '';
      let totalQty = 0;
      let grandTotal = 0;

      if (cart.length === 0) {
        document.getElementById('emptyCartNotice').style.display = 'block';
        document.getElementById('cartItemsContainer').style.display = 'none';
        document.getElementById('checkoutBtn').disabled = true;
      } else {
        document.getElementById('emptyCartNotice').style.display = 'none';
        document.getElementById('cartItemsContainer').style.display = 'block';
        document.getElementById('checkoutBtn').disabled = false;

        cart.forEach(item => {
          totalQty += item.quantity;
          const subtotal = item.price * item.quantity;
          grandTotal += subtotal;

          cartTableBody.innerHTML += `
            <tr>
              <td><span class="fw-semibold text-dark">${item.name}</span></td>
              <td>Rp ${item.price.toLocaleString('id-ID')}</td>
              <td>
                <div class="input-group input-group-sm" style="width: 90px;">
                  <button class="btn btn-outline-secondary" type="button" onclick="updateQuantity('${item.id}', -1)">-</button>
                  <input type="text" class="form-control text-center" value="${item.quantity}" readonly>
                  <button class="btn btn-outline-secondary" type="button" onclick="updateQuantity('${item.id}', 1)">+</button>
                </div>
              </td>
              <td class="fw-semibold">Rp ${subtotal.toLocaleString('id-ID')}</td>
              <td>
                <button class="btn btn-sm text-danger" onclick="removeFromCart('${item.id}')" title="Hapus"><i class="bi bi-trash"></i></button>
              </td>
            </tr>
          `;
        });
      }

      cartBadge.textContent = totalQty;
      document.getElementById('cartTotalPrice').textContent = 'Rp ' + grandTotal.toLocaleString('id-ID');
    }

    document.addEventListener('DOMContentLoaded', updateCartUI);

    async function submitCheckout() {
      const form = document.getElementById('checkoutForm');
      const buyerName = form.buyerName.value.trim();
      const buyerPhone = form.buyerPhone.value.trim();
      const address = form.address.value.trim();

      if (!buyerName || !buyerPhone || !address) {
        alert('Mohon lengkapi Nama, No. WhatsApp, dan Alamat pengiriman!');
        return;
      }

      if (cart.length === 0) {
        alert('Keranjang belanja masih kosong!');
        return;
      }

      const productNameSummary = cart.map(i => `${i.name} (${i.quantity}x)`).join(', ');
      const totalAmount = cart.reduce((sum, i) => sum + (i.price * i.quantity), 0);

      const formData = new URLSearchParams();
      formData.append('buyerName', buyerName);
      formData.append('buyerPhone', buyerPhone);
      formData.append('productName', productNameSummary);
      formData.append('quantity', cart.reduce((s, i) => s + i.quantity, 0));
      formData.append('totalPrice', totalAmount);
      formData.append('address', address);

      try {
        await fetch('/admin/pesanan/tambah', {
          method: 'POST',
          body: formData,
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
        });
      } catch (err) {
        console.error('Gagal mencatat pesanan ke DB:', err);
      }

      const phoneAdmin = "6285158110356";
      let waText = `Halo Admin BikeSupport, saya *${buyerName}* ingin memesan produk berikut:\n\n`;
      cart.forEach((item, idx) => {
        waText += `${idx + 1}. ${item.name} x ${item.quantity} = Rp ${(item.price * item.quantity).toLocaleString('id-ID')}\n`;
      });
      waText += `\n*Total Belanja: Rp ${totalAmount.toLocaleString('id-ID')}*`;
      waText += `\nAlamat Kirim: ${address}`;
      waText += `\n\nMohon konfirmasi dan proses pesanan saya. Terima kasih!`;

      cart = [];
      saveCart();
      const modalEl = document.getElementById('cartModal');
      const modalInstance = bootstrap.Modal.getInstance(modalEl);
      if (modalInstance) modalInstance.hide();

      window.open(`https://wa.me/${phoneAdmin}?text=${encodeURIComponent(waText)}`, '_blank');
      
      form.reset();
      alert('Pesanan berhasil dikirim dan dicatat ke sistem!');
    }
  </script>
</body>
</html>