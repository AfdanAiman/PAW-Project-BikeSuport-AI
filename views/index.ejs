<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        .hero-section {
            background-color: #0f172a;
            color: #ffffff;
            padding: 70px 20px;
            text-align: center;
        }
        .product-item {
            padding: 20px 0;
            border-bottom: 1px solid #e2e8f0;
        }
        .product-item:last-child {
            border-bottom: none;
        }
        .product-title-link {
            text-decoration: none;
            color: #1e293b;
            transition: color 0.2s ease;
        }
        .product-title-link:hover {
            color: #0d6efd;
        }
    </style>
</head>
<body>

    <!-- Navbar dengan 3 Menu (Produk, API produk, API status) -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm py-3">
        <div class="container">
            <a class="navbar-brand fw-bold fs-4 d-flex align-items-center gap-2" href="/">
                <span>🚲</span> <span>BikeSupport</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <div class="navbar-nav ms-auto gap-3 align-items-lg-center">
                    <a class="nav-link text-light fw-medium" href="#katalog">Produk</a>
                    <a class="nav-link text-warning fw-medium" href="/api/produk" target="_blank">API produk</a>
                    <a class="nav-link text-warning fw-medium" href="/api/status" target="_blank">API status</a>
                </div>
            </div>
        </div>
    </nav>
    
    <!-- Hero Banner -->
    <header class="hero-section">
        <div class="container">
            <span class="badge bg-primary bg-opacity-25 text-info border border-primary border-opacity-50 mb-3 px-3 py-2 rounded-pill fw-semibold">
                PPAW Week 7 — MVC & REST API Integration
            </span>
            <h1 class="fw-bold display-5 mb-3 text-white">Pusat Sparepart Sepeda & E-Bike</h1>
            <p class="lead text-light opacity-75 mb-4 mx-auto" style="max-width: 700px;">
                Menjangkau pembeli luar kota secara langsung tanpa potongan biaya marketplace
            </p>
            <div class="mt-2">
                <span class="text-warning fw-bold fs-4 tracking-wide">⚡ Low Cost, High Profit ⚡</span>
            </div>
            <div class="mt-4">
                <a href="#katalog" class="btn btn-primary px-4 py-2 fw-semibold rounded-pill shadow">Jelajahi Katalog</a>
            </div>
        </div>
    </header>

    <!-- Main Content Katalog Produk -->
    <div class="container my-5 bg-white p-4 rounded-4 shadow-sm" id="katalog">
        <div class="mb-4 pb-2 border-bottom">
            <h2 class="fw-bold text-dark m-0">Katalog Produk & Suku Cadang</h2>
            <p class="text-muted m-0 small">Klik pada nama produk untuk melihat detail spesifikasi secara lengkap.</p>
        </div>

        <div class="product-list">
            <% products.forEach(product => { %>
                <div class="product-item row align-items-center">
                    <!-- Kiri: Nama Produk (Bisa diklik), Deskripsi, Kategori -->
                    <div class="col-md-8 mb-3 mb-md-0">
                        <h5 class="fw-bold mb-1">
                            <a href="/produk/<%= product.id %>" class="product-title-link">
                                <%= product.name %>
                            </a>
                        </h5>
                        <p class="text-muted small mb-2"><%= product.description %></p>
                        <span class="badge bg-light text-secondary border px-2 py-1"><%= product.category %></span>
                    </div>

                    <!-- Kanan: Harga & Tombol WhatsApp -->
                    <div class="col-md-4 text-md-end d-flex flex-column align-items-md-end align-items-start gap-2">
                        <span class="text-success fs-5 fw-bold"><%= formatRupiah(product.price) %></span>
                        <a href="https://wa.me/6285158110356?text=Halo%20Admin%20BikeSupport,%20saya%20tertarik%20untuk%20membeli%20produk:%20*<%= encodeURIComponent(product.name) %>*" 
                           target="_blank" 
                           class="btn btn-outline-success btn-sm fw-semibold px-3 py-2">
                           💬 Pesan via WhatsApp
                        </a>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-dark text-white text-center py-4 mt-5">
        <div class="container">
            <p class="mb-0 small text-muted">&copy; 2026 BikeSupport Web Store. Dikembangkan untuk Tugas PPAW Week 7.</p>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>