<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans p-8">
    <div class="max-w-xl mx-auto bg-white p-6 rounded-lg shadow-md">
        <h1 class="text-2xl font-bold mb-6 text-gray-800">Edit Produk</h1>
        <form action="/edit-produk/<%= product.id %>" method="POST" class="space-y-4">
            <div>
                <label class="block text-gray-700 font-semibold mb-1">Nama Produk</label>
                <input type="text" name="name" value="<%= product.name %>" required class="w-full border rounded p-2 border-gray-300">
            </div>
            <div>
                <label class="block text-gray-700 font-semibold mb-1">Harga (Rp)</label>
                <input type="number" name="price" value="<%= product.price %>" required class="w-full border rounded p-2 border-gray-300">
            </div>
            <div>
                <label class="block text-gray-700 font-semibold mb-1">Kategori</label>
                <select name="category" required class="w-full border rounded p-2 border-gray-300">
                    <option value="Sparepart" <%= product.category === 'Sparepart' ? 'selected' : '' %>>Sparepart</option>
                    <option value="Aksesoris" <%= product.category === 'Aksesoris' ? 'selected' : '' %>>Aksesoris</option>
                    <option value="E-Bike" <%= product.category === 'E-Bike' ? 'selected' : '' %>>E-Bike</option>
                </select>
            </div>
            <div>
                <label class="block text-gray-700 font-semibold mb-1">Deskripsi</label>
                <textarea name="description" rows="3" class="w-full border rounded p-2 border-gray-300"><%= product.description %></textarea>
            </div>
            <div class="flex justify-between items-center pt-4">
                <a href="/" class="text-gray-600 hover:underline">Batal</a>
                <button type="submit" class="bg-green-600 text-white px-4 py-2 rounded font-semibold hover:bg-green-700">Simpan Perubahan</button>
            </div>
        </form>
    </div>
</body>
</html>