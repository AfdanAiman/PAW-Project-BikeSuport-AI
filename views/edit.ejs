<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
</head>
<body>

  <%- include('partials/navbar', { active: '' }) %>

  <main class="container my-5" style="max-width:720px">
    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb mb-0 small">
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Beranda</a></li>
        <li class="breadcrumb-item"><a href="/produk/<%= product.id %>" class="text-decoration-none"><%= product.name %></a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit</li>
      </ol>
    </nav>

    <div class="surface p-4 p-md-5">
      <div class="d-flex align-items-center gap-3 mb-4">
        <div class="d-flex align-items-center justify-content-center fs-4" style="width:50px;height:50px;border-radius:14px;background:#fffbeb;color:#d97706"><i class="bi bi-pencil-square"></i></div>
        <div class="flex-grow-1">
          <h1 class="h3 fw-bold mb-0">Edit Produk</h1>
          <p class="text-muted small mb-0">Perbarui informasi produk dan foto di katalog.</p>
        </div>
        <span class="badge rounded-pill text-bg-light border px-3 py-2 text-muted">ID #<%= product.id %></span>
      </div>

      <!-- WAJIB ENCTYPE MULTIPART UNTUK UPLOAD FILE -->
      <form action="/edit-produk/<%= product.id %>" method="POST" enctype="multipart/form-data" class="d-grid gap-4">
        <div>
          <label for="name" class="form-label">Nama Produk</label>
          <input type="text" id="name" name="name" value="<%= product.name %>" class="form-control" required>
        </div>

        <div class="row g-3">
          <div class="col-md-6">
            <label for="price" class="form-label">Harga</label>
            <div class="input-group">
              <span class="input-group-text">Rp</span>
              <input type="number" id="price" name="price" value="<%= product.price %>" class="form-control" min="0" required>
            </div>
          </div>
          <div class="col-md-6">
            <label for="category" class="form-label">Kategori</label>
            <select id="category" name="category" class="form-select" required>
              <option value="Sparepart" <%= product.category === 'Sparepart' ? 'selected' : '' %>>Sparepart</option>
              <option value="Aksesoris" <%= product.category === 'Aksesoris' ? 'selected' : '' %>>Aksesoris</option>
              <option value="E-Bike" <%= product.category === 'E-Bike' ? 'selected' : '' %>>E-Bike</option>
            </select>
          </div>
        </div>

        <div>
          <label for="description" class="form-label">Deskripsi</label>
          <textarea id="description" name="description" rows="4" class="form-control"><%= product.description %></textarea>
        </div>

        <!-- INPUT UPLOAD FOTO PRODUK -->
        <div>
          <label for="image" class="form-label">Ganti Foto Produk</label>
          <% if (product.image) { %>
            <div class="mb-2">
              <img src="<%= product.image %>" alt="Preview Foto" class="rounded border" style="width: 80px; height: 80px; object-fit: cover;">
              <span class="text-muted small ms-2">Foto saat ini</span>
            </div>
          <% } %>
          <input type="file" id="image" name="image" class="form-control" accept="image/*">
          <small class="text-muted">Biarkan kosong jika tidak ingin mengubah foto produk.</small>
        </div>

        <div class="d-flex flex-column-reverse flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-2 pt-3 border-top">
          <a href="/" class="btn btn-soft px-4">Batal</a>
          <button type="submit" class="btn btn-brand px-4 py-2"><i class="bi bi-check2-circle me-1"></i> Simpan Perubahan</button>
        </div>
      </form>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>