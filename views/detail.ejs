<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; color: #1e293b; }
    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm py-3">
        <div class="container">
            <a class="navbar-brand fw-bold fs-4" href="/">🚲 BikeSupport Web Store</a>
            <div class="navbar-nav ms-auto gap-3">
                <a class="nav-link text-light fw-medium" href="/">Kembali ke Beranda</a>
            </div>
        </div>
    </nav>

    <!-- Detail Produk Content -->
    <div class="container my-5" style="max-width: 800px;">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Beranda</a></li>
                <li class="breadcrumb-item"><a href="/#katalog" class="text-decoration-none">Katalog</a></li>
                <li class="breadcrumb-item active" aria-current="page"><%= product.name %></li>
            </ol>
        </nav>

        <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4 bg-white">
            <div class="mb-3">
                <span class="badge bg-secondary px-3 py-2"><%= product.category %></span>
            </div>
            
            <h1 class="fw-bold text-dark mb-3"><%= product.name %></h1>
            
            <div class="fs-3 fw-bold text-success mb-4">
                <%= formatRupiah(product.price) %>
            </div>

            <hr class="text-muted opacity-25 mb-4">

            <h5 class="fw-bold text-dark mb-2">Deskripsi Produk</h5>
            <p class="text-muted lh-lg mb-5"><%= product.description %></p>

            <div class="d-grid gap-2">
                <a href="https://wa.me/6285158110356?text=Halo%20Admin%20BikeSupport,%20saya%20tertarik%20untuk%20membeli%20produk:%20*<%= encodeURIComponent(product.name) %>* seharga <%= formatRupiah(product.price) %>" 
                   target="_blank" 
                   class="btn btn-success btn-lg fw-semibold py-3 shadow-sm">
                   💬 Beli / Pesan via WhatsApp (Tanpa Admin Fee)
                </a>
                <a href="/" class="btn btn-outline-secondary py-2 mt-2">← Lihat Produk Lainnya</a>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-dark text-white text-center py-4 mt-5">
        <div class="container">
            <p class="mb-0 small text-muted">&copy; 2026 BikeSupport Web Store. PPAW Week 7.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>