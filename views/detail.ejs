<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
  <style>
    .detail-thumb{border-radius:var(--radius);min-height:280px;height:100%}
    .detail-thumb i{font-size:6rem;opacity:.8}
    .detail-price{font-family:'Outfit',sans-serif;font-weight:800;font-size:2.2rem;color:var(--ink)}
    .info-tile{background:#f8fafc;border:1px solid var(--line);border-radius:12px;padding:12px 16px}
    .info-tile small{display:block;color:var(--muted);font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;font-weight:700}
    .breadcrumb a{text-decoration:none}
  </style>
</head>
<body>

  <%- include('partials/navbar', { active: '' }) %>

  <%
    const themes = {
      'Sparepart': { c: 'theme-sparepart', i: 'bi-gear' },
      'Aksesoris': { c: 'theme-aksesoris', i: 'bi-shield-shaded' },
      'E-Bike':    { c: 'theme-ebike',     i: 'bi-lightning-charge' }
    };
    const th = themes[product.category] || themes['Sparepart'];
    const isOpen = (typeof store === 'undefined') || store.open;
    const waText = 'Halo Admin BikeSupport, saya tertarik untuk membeli produk: *' + product.name + '* seharga ' + formatRupiah(product.price);
  %>

  <main class="container my-5" style="max-width:1000px">
    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb mb-0 small">
        <li class="breadcrumb-item"><a href="/">Beranda</a></li>
        <li class="breadcrumb-item"><a href="/#katalog">Katalog</a></li>
        <li class="breadcrumb-item active" aria-current="page"><%= product.name %></li>
      </ol>
    </nav>

    <div class="surface p-3 p-md-4">
      <div class="row g-4">
        <div class="col-md-5">
          <div class="thumb detail-thumb <%= th.c %>"><i class="bi <%= th.i %>"></i></div>
        </div>

        <div class="col-md-7 d-flex flex-column">
          <div class="d-flex flex-wrap gap-2 mb-3">
            <span class="badge rounded-pill text-bg-light border px-3 py-2"><i class="bi bi-tag me-1"></i><%= product.category %></span>
            <span class="badge rounded-pill text-bg-light border px-3 py-2 text-muted">ID #<%= product.id %></span>
          </div>

          <h1 class="fw-bold mb-2" style="font-size:clamp(1.6rem,3.5vw,2.2rem)"><%= product.name %></h1>
          <div class="detail-price mb-4"><%= formatRupiah(product.price) %></div>

          <div class="row g-2 mb-4">
            <div class="col-6"><div class="info-tile"><small>Kategori</small><span class="fw-semibold text-dark"><%= product.category %></span></div></div>
            <div class="col-6"><div class="info-tile"><small>Harga Jual</small><span class="fw-semibold text-dark"><%= formatRupiah(product.price) %></span></div></div>
          </div>

          <h2 class="h6 fw-bold text-uppercase text-muted mb-2" style="letter-spacing:.05em">Deskripsi Produk</h2>
          <p class="lh-lg mb-4"><%= product.description || 'Belum ada deskripsi untuk produk ini.' %></p>

          <div class="mt-auto d-grid gap-2">
            <!-- TOMBOL PEMESANAN WHATSAPP HANYA MUNCUL JIKA BUKAN ADMIN -->
            <% if (!locals.isAdmin) { %>
              <% if (isOpen) { %>
              <a href="https://wa.me/6285158110356?text=<%= encodeURIComponent(waText) %>" target="_blank" rel="noopener"
                 class="btn btn-success btn-lg py-3 d-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-whatsapp"></i> Pesan via WhatsApp
              </a>
              <% } else { %>
              <button type="button" class="btn btn-lg py-3 d-flex align-items-center justify-content-center gap-2" style="background:#e2e8f0;color:#475569" disabled>
                <i class="bi bi-moon-stars"></i> Toko Sedang Tutup — Pemesanan Dinonaktifkan
              </button>
              <% } %>
            <% } %>

            <!-- TOMBOL NAVIGASI & MANAJEMEN ADMIN -->
            <div class="d-flex gap-2">
              <a href="/" class="btn btn-soft flex-grow-1 py-2"><i class="bi bi-arrow-left me-1"></i> Produk Lainnya</a>
              
              <% if (locals.isAdmin) { %>
              <a href="/edit-produk/<%= product.id %>" class="btn btn-soft py-2 px-3" title="Edit produk"><i class="bi bi-pencil-square me-1"></i> Edit</a>
              <form action="/hapus-produk/<%= product.id %>" method="POST" class="d-inline" onsubmit="return confirm('Yakin ingin menghapus produk ini?')">
                <button type="submit" class="btn btn-soft danger py-2 px-3" title="Hapus produk"><i class="bi bi-trash"></i></button>
              </form>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>