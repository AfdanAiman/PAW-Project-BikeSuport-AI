<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="BikeSupport Web Store — katalog suku cadang, aksesoris, dan E-Bike profesional.">
<title><%= title %></title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
  :root{
    --brand:#4f46e5; --brand-600:#4338ca; --brand-soft:#eef2ff; --brand-light:#818cf8;
    --ink:#0f172a; --text:#334155; --muted:#64748b; --line:#e2e8f0;
    --bg:#f6f7fb; --surface:#fff; --dark:#09090b;
    --radius:16px;
    --shadow-sm:0 1px 2px rgba(15,23,42,.05),0 1px 3px rgba(15,23,42,.06);
    --shadow-md:0 14px 34px -14px rgba(15,23,42,.22);
  }
  html{scroll-behavior:smooth}
  body{font-family:'Inter',system-ui,sans-serif;background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased;overflow-x:hidden}
  h1,h2,h3,h4,h5,h6{color:var(--ink)}
  h1,h2,h3,h4,h5,h6,.font-display{font-family:'Outfit',sans-serif;letter-spacing:-.015em}
  .navbar-brand{color:#fff!important}
  .site-footer .font-display{color:#fff}
  a{color:var(--brand)}
  ::selection{background:rgba(79,70,229,.2)}
  :focus-visible{outline:3px solid rgba(79,70,229,.45);outline-offset:2px}

  /* Navbar */
  .navbar-custom{background:rgba(9,9,11,.88);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid rgba(255,255,255,.08)}
  .brand-mark{width:38px;height:38px;border-radius:11px;background:linear-gradient(135deg,var(--brand),#7c3aed);color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 16px -4px rgba(79,70,229,.6)}
  .navbar-custom .nav-link{color:#cbd5e1;font-weight:500;border-radius:999px;padding:.5rem 1rem;transition:.2s}
  .navbar-custom .nav-link:hover{color:#fff;background:rgba(255,255,255,.08)}
  .navbar-custom .nav-link.active{color:#fff;background:rgba(255,255,255,.12)}

  /* Buttons */
  .btn{border-radius:10px;font-weight:600}
  .btn-brand{background:var(--brand);color:#fff;border:0;transition:.2s}
  .btn-brand:hover,.btn-brand:focus{background:var(--brand-600);color:#fff;transform:translateY(-1px);box-shadow:0 8px 18px -8px rgba(79,70,229,.7)}
  .btn-ghost-light{background:rgba(255,255,255,.08);color:#fff;border:1px solid rgba(255,255,255,.2)}
  .btn-ghost-light:hover{background:rgba(255,255,255,.16);color:#fff}
  .btn-soft{background:#fff;border:1px solid var(--line);color:var(--text)}
  .btn-soft:hover{background:#f8fafc;border-color:#cbd5e1;color:var(--ink)}
  .btn-soft.danger:hover{color:#dc2626;border-color:#fecaca;background:#fef2f2}

  /* Surfaces */
  .surface{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow-sm)}

  /* Category themes */
  .theme-sparepart{--t1:#e0f2fe;--t2:#bae6fd;--tf:#0369a1}
  .theme-aksesoris{--t1:#dcfce7;--t2:#bbf7d0;--tf:#15803d}
  .theme-ebike{--t1:#fef9c3;--t2:#fde68a;--tf:#a16207}
  .thumb{display:flex;align-items:center;justify-content:center;position:relative;background:linear-gradient(135deg,var(--t1),var(--t2));color:var(--tf)}

  /* Forms */
  .form-label{font-weight:600;color:var(--ink);font-size:.9rem}
  .form-control,.form-select,.input-group-text{border-color:#cbd5e1;border-radius:10px;padding:.65rem .9rem}
  .input-group>.form-control{border-radius:0 10px 10px 0}
  .input-group>.input-group-text{border-radius:10px 0 0 10px;background:#f8fafc;color:var(--muted);font-weight:600}
  .form-control:focus,.form-select:focus{border-color:var(--brand);box-shadow:0 0 0 4px rgba(79,70,229,.14)}

  /* Footer */
  .site-footer{background:var(--dark);color:#cbd5e1;border-top:1px solid rgba(255,255,255,.06)}
  .site-footer a{color:#cbd5e1;text-decoration:none}
  .site-footer a:hover{color:#fff}

  /* Status toko */
  .store-banner{background:linear-gradient(90deg,#92400e,#b45309);color:#fff;font-size:.88rem;padding:10px 0;text-align:center}
  .store-banner-pill{background:rgba(255,255,255,.18);border-radius:999px;padding:2px 12px;font-weight:600}
  .store-toast{position:fixed;top:88px;right:16px;z-index:1100;padding:12px 18px;border-radius:12px;font-size:.9rem;font-weight:500;box-shadow:var(--shadow-md);animation:toastIn .3s ease}
  .store-toast.ok{background:#ecfdf5;color:#047857;border:1px solid #a7f3d0}
  .store-toast.err{background:#fef2f2;color:#b91c1c;border:1px solid #fecaca}
  @keyframes toastIn{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}

  @media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important;scroll-behavior:auto!important}}
</style>
